# Copy to `.env` for local development (ignored by git). Docker Compose reads this via `env_file` if you add it.

# --- Database (local Postgres; Docker overrides these via compose) ---
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_NAME=whynot_development

# --- Auth ---
# Required in production. Development falls back to a non-secret default if unset.
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24

# --- CORS (comma-separated origins; default in code allows common local dev ports) ---
CORS_ORIGINS=http://localhost:3002,http://localhost:5173

# --- OpenAI (AI rejection analysis — optional in local dev) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.35
# OPENAI_HTTP_READ_TIMEOUT=300
# OPENAI_HTTP_OPEN_TIMEOUT=30
# OPENAI_MAX_COMPLETION_TOKENS=16384

# --- Rails ---
# RAILS_ENV=development
# RAILS_MAX_THREADS=5

# Production example (managed host or Kamal):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/whynot_production
# RAILS_MASTER_KEY=<from config/master.key>
