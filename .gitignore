# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add them to a global gitignore:
#   git config --global core.excludesfile '~/.gitignore_global'

/.bundle/
/.env
/.env.*.local

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
/tmp/cache/

# Debug session logs (Cursor)
debug-*.log
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key

# IDEs
.idea/
.vscode/
*.swp
*.swo
